# Copiá este archivo a .env.local y completá con los datos de TU proyecto de Supabase
# (Dashboard → Settings → API). .env.local está ignorado por git: nunca lo subas.
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<clave-publica>

# Para probar sin base de datos no hace falta este archivo: npm run demo (usa .env.demo).
